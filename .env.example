# LLM: проверенная конфигурация — DeepSeek V4.1 Flash через OpenRouter на DeepInfra fp8 (см. docs/experiments/).
# Пустые значения = умолчания из config.py. Настройки из output/system.db (через UI) важнее .env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
FAST_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017
POWERFUL_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_PROVIDER_ORDER=deepinfra/fp8
OPENROUTER_REASONING_EFFORT=
OPENROUTER_REASONING_BY_STAGE={"emotion_analysis": "none"}
TTS_API_URL
COSYVOICE_API_URL
COMFY_SERVER_ADDRESS

# Optional (goto tools/readme.md)
ELEVENLABS_API_KEY
RANOBELIB_USER_TOKEN